POPVID_BASE_URL=https://popvid.ai/api/public/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=8787
MAX_CONCURRENT_SESSIONS=3
# Public HTTPS origin that serves /luca.jpg (576x768). PopVid fetches the first frame from there.
# Localhost will not work. On Render the request host is used automatically.
# PUBLIC_BASE_URL=https://your-app.onrender.com
# SEED_IMAGE_URL=https://your-cdn.example.com/luca.jpg
# Optional licensed voice sample (first 10 seconds are used).
# VOICE_REF_URL=https://your-cdn.example.com/luca-voice.mp3
